# Local Artisan configuration. Docker Compose reads the root ../.env instead.
APP_ENV=local
APP_URL=http://127.0.0.1:8000
APP_KEY=
APP_PREVIOUS_KEYS=

# Optional local HTTPS tunnel/proxy metadata for webhook development.
TRUSTED_PROXIES=
TRUSTED_HOSTS=

# Required only for real local Telegram interaction.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=

# Optional provider credentials for the specific integration being exercised.
PAKASIR_SLUG=
PAKASIR_API_KEY=
BINANCE_PAY_ID=
BINANCE_PAY_UID=
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional override for a private or credentialed BSC provider. Public BSC
# endpoints are pinned in config/services.php and used as ordered fallbacks
# when this is empty.
BSC_RPC_URL=
KLIKQRIS_SANDBOX_API_KEY=
KLIKQRIS_SANDBOX_MERCHANT_ID=
KLIKQRIS_PRODUCTION_API_KEY=
KLIKQRIS_PRODUCTION_MERCHANT_ID=
# Both production values enable Sakurupiah in production; sandbox values are
# used only in local/testing.
SAKURUPIAH_SANDBOX_API_ID=
SAKURUPIAH_SANDBOX_API_KEY=
SAKURUPIAH_PRODUCTION_API_ID=
SAKURUPIAH_PRODUCTION_API_KEY=

# Optional independent HMAC key; APP_KEY is the default.
CREDENTIAL_IDENTITY_FINGERPRINT_KEY=

# Optional local database override. Tests replace these with SQLite in memory.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Optional Resend SMTP. Provision a sending-only, notify.lhiestore.web.id-restricted
# API key privately as MAIL_PASSWORD. Disable domain open/click tracking.
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=no-reply@notify.lhiestore.web.id
# MAIL_FROM_NAME="LHIE STORE"
