APP_NAME="LHIE STORE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
# Health check endpoint: /up
APP_FORCE_HTTPS=true
APP_AUTO_SET_TELEGRAM_WEBHOOK=false
TRUSTED_PROXIES=*
TRUSTED_HOSTS=^example\.com$

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
DOGFOOD_TIMING_ENABLED=false
DOGFOOD_TIMING_LOG_CHANNEL=

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=telegram_bot
DB_USERNAME=telegram_bot
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_PAYMENT_MODE=manual
TELEGRAM_WEBHOOK_RATE_LIMIT_PER_MINUTE=120
TELEGRAM_ADMIN_CONTACT_URL=
TELEGRAM_ADMIN_USERNAME=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_ADMIN_CHAT_ID=

DOGFOOD_TELEGRAM_PHOTO_FILE_ID=
DOGFOOD_STORE_CHANNEL_CHAT_ID=
DOGFOOD_STORE_CHANNEL_USERNAME=
DOGFOOD_STORE_CHANNEL_LINK=
DOGFOOD_STORE_CHANNEL_MEMBER_USER_ID=
DOGFOOD_STORE_CHANNEL_NON_MEMBER_USER_ID=
DOGFOOD_TELEGRAM_CALLBACK_QUERY_ID=
DOGFOOD_PAKASIR_PENDING_ORDER_ID=
DOGFOOD_PAKASIR_PENDING_AMOUNT=

PAKASIR_SLUG=
PAKASIR_API_KEY=
PAKASIR_BASE_URL=https://app.pakasir.com
PAKASIR_REDIRECT_URL=${APP_URL}
PAKASIR_QRIS_ONLY=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
