APP_NAME="LHIE STORE"
APP_ENV=production
APP_KEY=
# Optional dedicated HMAC key for credential identity no-reuse fingerprints.
# If omitted, the app generates and persists one in storage/app/private.
CREDENTIAL_IDENTITY_FINGERPRINT_KEY=
APP_DEBUG=false
APP_URL=https://example.com
# Health check endpoint: /up
APP_FORCE_HTTPS=true
STOREFRONT_SITEMAP_MAX_URLS=1000
APP_AUTO_SET_TELEGRAM_WEBHOOK=false
# Comma-separated IP/CIDR of the reverse proxy only. Leave empty when the app is directly exposed.
TRUSTED_PROXIES=
TRUSTED_HOSTS=^example\.com$

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Jakarta
STOREFRONT_LOCALE=id
STOREFRONT_PAYMENT_STATUS_POLL_INTERVAL_SECONDS=20
STOREFRONT_PAYMENT_STATUS_POLL_MAX_ATTEMPTS=9
STOREFRONT_PAYMENT_STATUS_POLL_MAX_DURATION_SECONDS=180


APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
# Comma-separated admin emails/usernames allowed into the dashboard.
# SECURITY: leave empty and ANY account holding an admin role can sign in
# (User::canAccessAdmin falls open). Set this in production to lock the
# dashboard to named accounts.
ADMIN_ALLOWED_LOGINS=
# Failed admin login attempts per normalized identity/IP and per source IP.
ADMIN_LOGIN_IDENTITY_MAX_ATTEMPTS=5
ADMIN_LOGIN_IDENTITY_DECAY_SECONDS=60
ADMIN_LOGIN_IP_MAX_ATTEMPTS=10
ADMIN_LOGIN_IP_DECAY_SECONDS=60

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=telegram_bot
DB_USERNAME=telegram_bot
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_PARTITIONED_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
LARAVEL_UPDATE_WORKER_PROCESSES=1
LARAVEL_UPDATE_WORKER_SLEEP=1
LARAVEL_OUTBOUND_WORKER_PROCESSES=1
LARAVEL_OUTBOUND_WORKER_SLEEP=1
LARAVEL_NOTIFICATION_WORKER_PROCESSES=1
LARAVEL_BROADCAST_WORKER_PROCESSES=1
LARAVEL_BROADCAST_WORKER_SLEEP=1
LARAVEL_BINANCE_VERIFICATION_WORKER_PROCESSES=1
BACKUP_DIR=backups
DB_SERVICE=db
# Required for ../scripts/backup-db.sh; set one encryption mode.
GPG_RECIPIENT=
GPG_PASSPHRASE=
DATA_RETENTION_DAYS=90

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Customer login, guest-order, and product-waitlist transactional emails
# require a production transactional SMTP provider. Keep SMTP credentials in
# secrets, not in the repository. For submission over TLS, use port 587 and:
# MAIL_SCHEME=tls
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org
# HTTP timeout applies to every Telegram Bot API call.
TELEGRAM_HTTP_TIMEOUT_SECONDS=30
TELEGRAM_HTTP_CONNECT_TIMEOUT_SECONDS=10
# Let Telegram stop the inline-button spinner from the webhook response itself.
TELEGRAM_WEBHOOK_FAST_CALLBACK_ACK=true
TELEGRAM_WEBHOOK_RATE_LIMIT_PER_MINUTE=120
TELEGRAM_COMMUNITY_GATE_CACHE_SECONDS=15
TELEGRAM_PROCESSING_MAX_ATTEMPTS=3
TELEGRAM_PROCESSING_RETRY_DELAY_SECONDS=60
# Shared Admin Broadcast limiter. Keep this below Telegram's default 30 messages/second.
TELEGRAM_BROADCAST_RATE_LIMIT_PER_SECOND=25
TELEGRAM_ADMIN_CONTACT_URL=
TELEGRAM_ADMIN_USERNAME=alhie02
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_ADMIN_CHAT_ID=
WHATSAPP_SUPPORT_URL=
WHATSAPP_SUPPORT_NUMBER=
# Leave blank to use APP_URL/admin for the Telegram Mini App dashboard.
TELEGRAM_MINI_APP_URL=
STOREFRONT_TELEGRAM_BOT_URL=https://t.me/lhiestore_bot?start=landing
# Optional Telegram file_id/URL override. Leave blank; /start uses resources/images/banner-welcome.jpg by default.
TELEGRAM_WELCOME_BANNER_URL=
# Short-lived shared cache for all-time /start metrics, in seconds.
TELEGRAM_START_METRICS_CACHE_SECONDS=60

PAKASIR_SLUG=
PAKASIR_API_KEY=
PAKASIR_BASE_URL=https://app.pakasir.com
# HTTP timeout applies to every Pakasir API call. Retries apply only to Transaction Detail.
PAKASIR_HTTP_TIMEOUT_SECONDS=10
PAKASIR_HTTP_CONNECT_TIMEOUT_SECONDS=3
PAKASIR_TRANSACTION_DETAIL_MAX_ATTEMPTS=3
PAKASIR_TRANSACTION_DETAIL_RETRY_DELAY_MS=250
PAKASIR_TRANSACTION_DETAIL_RETRY_MAX_DELAY_MS=1000
PAKASIR_RECONCILE_RELEASED_LOOKBACK_HOURS=72
# Optional; leave blank to use Pakasir default hosted-checkout return behavior.
PAKASIR_REDIRECT_URL=
PAKASIR_WEBHOOK_RATE_LIMIT_PER_MINUTE=30
PAKASIR_STATUS_REFRESH_RATE_LIMIT_PER_MINUTE=3
PAKASIR_STATUS_REFRESH_LOCK_LEASE_SECONDS=15
PAKASIR_STATUS_REFRESH_SINGLE_FLIGHT_WINDOW_SECONDS=5
PAKASIR_STATUS_REFRESH_IN_PROGRESS_RETRY_AFTER_SECONDS=3
PAKASIR_QRIS_FEE_PAYER=customer
PAKASIR_QRIS_FEE_THRESHOLD=105000
PAKASIR_QRIS_FEE_LOW_BPS=70
PAKASIR_QRIS_FEE_LOW_FIXED=310
PAKASIR_QRIS_FEE_HIGH_BPS=100
PAKASIR_QRIS_FEE_HIGH_FIXED=0
KLIKQRIS_SANDBOX_ENABLED=false
KLIKQRIS_SANDBOX_BASE_URL=https://klikqris.com/api/sandbox
KLIKQRIS_SANDBOX_API_KEY=
KLIKQRIS_SANDBOX_MERCHANT_ID=
KLIKQRIS_SANDBOX_CALLBACK_URL=
KLIKQRIS_SANDBOX_CALLBACK_ALLOWED_HOSTS=
# Production values are separate from sandbox values and must be configured
# only after the sandbox evidence gate and owner approval.
KLIKQRIS_PRODUCTION_ENABLED=false
KLIKQRIS_PRODUCTION_BASE_URL=
KLIKQRIS_PRODUCTION_API_KEY=
KLIKQRIS_PRODUCTION_MERCHANT_ID=
KLIKQRIS_PRODUCTION_CALLBACK_URL=
# Comma-separated HTTPS KlikQRIS API hostnames and callback hostnames.
KLIKQRIS_PRODUCTION_ALLOWED_HOSTS=
KLIKQRIS_PRODUCTION_CALLBACK_ALLOWED_HOSTS=
KLIKQRIS_QRIS_TTL_MINUTES=15
KLIKQRIS_HTTP_TIMEOUT_SECONDS=10
KLIKQRIS_HTTP_CONNECT_TIMEOUT_SECONDS=3
KLIKQRIS_STATUS_MAX_ATTEMPTS=3
KLIKQRIS_RECOVERY_ALERT_MAX_ATTEMPTS=3
KLIKQRIS_STATUS_RETRY_DELAY_MS=250
KLIKQRIS_WEBHOOK_RATE_LIMIT_PER_MINUTE=30
KLIKQRIS_STATUS_REFRESH_RATE_LIMIT_PER_MINUTE=3
# Reporting responses are cached briefly; withdrawal page limits are bounded by the client.
KLIKQRIS_REPORTING_CACHE_SECONDS=15
KLIKQRIS_REPORTING_MAX_LIMIT=100
STOREFRONT_CHECKOUT_RATE_LIMIT_PER_MINUTE=5
STOREFRONT_CREDENTIAL_ACCESS_RATE_LIMIT_PER_MINUTE=5
STOREFRONT_CREDENTIAL_ACCESS_SESSION_MINUTES=30
STOREFRONT_INVOICE_URL_TTL_DAYS=7
STOREFRONT_TERMS_VERSION=2026-07-20
# Optional dedicated HMAC key for waitlist deduplication. If blank, APP_KEY is used.
STOREFRONT_WAITLIST_HASH_KEY=
STOREFRONT_WAITLIST_CONFIRMATION_TTL_MINUTES=60
STOREFRONT_WAITLIST_UNSUBSCRIBE_TTL_DAYS=30
STOREFRONT_WAITLIST_MAX_RECIPIENTS_PER_EVENT=500
STOREFRONT_WAITLIST_IP_RATE_LIMIT_PER_HOUR=30
STOREFRONT_WAITLIST_EMAIL_RATE_LIMIT_PER_HOUR=5
STOREFRONT_WAITLIST_PRODUCT_RATE_LIMIT_PER_HOUR=100

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
BINANCE_PAY_ID=
BINANCE_PAY_UID=

# Read-only Binance API key (Enable Reading + IP restriction only). When both
# values are set, Binance Pay orders are verified and delivered automatically.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_VERIFICATION_QUEUE=binance-verification
DB_QUEUE_RETRY_AFTER=180
BINANCE_HISTORY_CACHE_SECONDS=20
BINANCE_HISTORY_LOCK_SECONDS=90
BINANCE_HISTORY_MAX_DURATION_SECONDS=45
BINANCE_VERIFY_CLOCK_SKEW_SECONDS=0

# BNB Smart Chain authority and immutable network identity. Receiving
# addresses are managed from the admin dashboard and must not be placed here.
BSC_RPC_URL=
BSC_INDEXED_SOURCE=
BSC_INDEXER_URL=
BSC_CHAIN_ID=56
BSC_USDT_CONTRACT=
BSC_USDT_DECIMALS=18
BSC_EXPLORER_BASE_URL=https://bscscan.com
BSC_EXPLORER_ALLOWED_HOSTS=bscscan.com,www.bscscan.com
# RPC calls are bounded and scanner log ranges/results are capped.
BSC_RPC_TIMEOUT_SECONDS=5
BSC_RPC_CONNECT_TIMEOUT_SECONDS=2
BSC_RPC_MAX_ATTEMPTS=2
BSC_RPC_RETRY_DELAY_MS=150
BSC_MAX_SCAN_BLOCKS=10000
BSC_MAX_SCAN_LOGS=1000
BSC_PENDING_BACKLOG_ALERT_THRESHOLD=50
BSC_LATE_PAYMENT_LOOKBACK_HOURS=72
BSC_OWNER_ALERT_COOLDOWN_SECONDS=900
BSC_READINESS_CACHE_SECONDS=60
