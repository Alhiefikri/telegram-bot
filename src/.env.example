APP_NAME="LHIE STORE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
# Health check endpoint: /up
APP_FORCE_HTTPS=true
APP_AUTO_SET_TELEGRAM_WEBHOOK=false
TRUSTED_PROXIES=*
TRUSTED_HOSTS=^example\.com$

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
ADMIN_ALLOWED_LOGINS=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=telegram_bot
DB_USERNAME=telegram_bot
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_PARTITIONED_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

ORDERS_PENDING_PAYMENT_TTL_MINUTES=5

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_PAYMENT_MODE=manual
TELEGRAM_WEBHOOK_RATE_LIMIT_PER_MINUTE=120
TELEGRAM_ADMIN_CONTACT_URL=
TELEGRAM_ADMIN_USERNAME=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_ADMIN_CHAT_ID=
# Leave blank to use APP_URL/admin for the Telegram Mini App dashboard.
TELEGRAM_MINI_APP_URL=
STOREFRONT_TELEGRAM_BOT_URL=https://t.me/lhiestore_bot?start=landing
# Optional Telegram file_id/URL override. Leave blank; /start uses resources/images/banner-welcome.jpg by default.
TELEGRAM_WELCOME_BANNER_URL=
TELEGRAM_PRODUCT_CUSTOM_EMOJI_ENABLED=true
TG_ICON_CHATGPT=
TG_ICON_GEMINI=
TG_ICON_GROK=
TG_ICON_CAPCUT=
TG_ICON_ADOBE=
TG_ICON_CURSOR=
TG_ICON_YOUTUBE=
TG_ICON_KLING=
TG_ICON_LOVABLE=
TG_ICON_NOTION=

PAKASIR_SLUG=
PAKASIR_API_KEY=
PAKASIR_BASE_URL=https://app.pakasir.com
# Optional; leave blank to use Pakasir default hosted-checkout return behavior.
PAKASIR_REDIRECT_URL=
PAKASIR_QRIS_ONLY=false
# Allowed: hosted, api_qris. Default hosted keeps native QRIS opt-in.
PAKASIR_CHECKOUT_FLOW=hosted
PAKASIR_WEBHOOK_RATE_LIMIT_PER_MINUTE=30
PAKASIR_WEBHOOK_REPLAY_TTL_MINUTES=10
PAKASIR_STATUS_REFRESH_RATE_LIMIT_PER_MINUTE=3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
