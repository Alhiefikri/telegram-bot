<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="PostgreSQL release integration">
            <file>tests/Feature/Telegram/WebhookIngressTest.php</file>
            <file>tests/Feature/ProductInventoryRaceTest.php</file>
            <file>tests/Feature/StorefrontProductCheckoutTest.php</file>
            <file>tests/Feature/StorefrontShopCheckoutTest.php</file>
            <file>tests/Feature/Telegram/CartCheckoutTest.php</file>
            <file>tests/Feature/Telegram/PaymentProofAdminCallbackTest.php</file>
            <file>tests/Feature/AdminOrderPaymentOperationsTest.php</file>
            <file>tests/Feature/KlikQrisNativeQrisTest.php</file>
            <file>tests/Feature/KlikQrisNativeQrisPostgresConcurrencyTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_FORCE_HTTPS" value="false" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="ADMIN_ALLOWED_LOGINS" value="" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_FOREIGN_KEYS" value="true" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELEGRAM_ADMIN_CHAT_ID" value="" force="true"/>
        <env name="TELEGRAM_BOT_TOKEN" value="" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
