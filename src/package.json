{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test:browser:admin": "npm run build && playwright test tests/Browser/admin-dashboard-responsive.spec.js",
    "test:browser:customer": "npm run build && playwright test tests/Browser/admin-dashboard-responsive.spec.js -g \"customer checkout\"",
    "test:browser:docker": "playwright test tests/Browser/docker-production-smoke.spec.js",
    "prepare": "cd .. && husky src/.husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "concurrently": "^9.0.1",
    "husky": "^9.1.7",
    "laravel-vite-plugin": "^2.1.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "alpinejs": "^3.15.12"
  }
}
