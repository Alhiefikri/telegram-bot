{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test:js": "node --test tests/JavaScript/*.test.js",
    "test:browser:admin": "npm run build && playwright test tests/Browser/admin-dashboard-responsive.spec.js",
    "test:browser:customer": "npm run build && playwright test tests/Browser/admin-dashboard-responsive.spec.js -g \"customer checkout\"",
    "test:browser:buymail": "npm run build && playwright test tests/Browser/buymail-warranty.spec.js",
    "test:browser:buymail:ci": "playwright test tests/Browser/buymail-warranty.spec.js",
    "test:browser:docker": "playwright test tests/Browser/docker-production-smoke.spec.js",
    "prepare": "cd .. && husky src/.husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "laravel-vite-plugin": "^3.1.3",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "alpinejs": "^3.15.12"
  },
  "overrides": {
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2"
  }
}
