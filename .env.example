APP_NAME="LHIE STORE"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=base64:replace-with-generated-key
APP_FORCE_HTTPS=true
APP_TIMEZONE=Asia/Jakarta
TRUSTED_PROXIES=127.0.0.1
TRUSTED_HOSTS=^example\.com$
WEB_PORT=8000

APP_AUTO_MIGRATE=false
APP_OPTIMIZE=true
APP_AUTO_SET_TELEGRAM_WEBHOOK=false

POSTGRES_DB=telegram_bot
POSTGRES_USER=telegram_bot
POSTGRES_PASSWORD=change-me

CACHE_STORE=database
QUEUE_CONNECTION=database
LARAVEL_UPDATE_WORKER_PROCESSES=1
LARAVEL_OUTBOUND_WORKER_PROCESSES=1
LARAVEL_NOTIFICATION_WORKER_PROCESSES=1
LARAVEL_BROADCAST_WORKER_PROCESSES=1
LARAVEL_BINANCE_VERIFICATION_WORKER_PROCESSES=1
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_PARTITIONED_COOKIE=true
FILESYSTEM_DISK=local
BACKUP_DIR=backups
DB_SERVICE=db
# Required for scripts/backup-db.sh; set one encryption mode.
GPG_RECIPIENT=
GPG_PASSPHRASE=
DATA_RETENTION_DAYS=90

MAIL_MAILER=smtp

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
TELEGRAM_API_BASE_URL=https://api.telegram.org
# HTTP timeout applies to every Telegram Bot API call.
TELEGRAM_HTTP_TIMEOUT_SECONDS=10
TELEGRAM_HTTP_CONNECT_TIMEOUT_SECONDS=3
TELEGRAM_WEBHOOK_RATE_LIMIT_PER_MINUTE=120
TELEGRAM_PROCESSING_MAX_ATTEMPTS=3
TELEGRAM_PROCESSING_RETRY_DELAY_SECONDS=60
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_ADMIN_USERNAME=alhie02
TELEGRAM_ADMIN_CONTACT_URL=

# Comma-separated admin emails/usernames allowed into the dashboard.
# SECURITY: leave empty and ANY account holding an admin role can sign in
# (User::canAccessAdmin falls open). Set this in production to lock the
# dashboard to named accounts.
ADMIN_ALLOWED_LOGINS=
WHATSAPP_SUPPORT_URL=
WHATSAPP_SUPPORT_NUMBER=
# Required only when Binance Pay is enabled in the admin dashboard.
BINANCE_PAY_ID=
BINANCE_PAY_UID=
# Optional read-only Binance API credentials enable automatic payment verification.
# Restrict this key by IP and grant read permission only.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_ORDER_ID_CANARY_MAX_AGE_HOURS=24
BINANCE_VERIFICATION_QUEUE=binance-verification
DB_QUEUE_RETRY_AFTER=180
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_HTTP_TIMEOUT_SECONDS=10
BINANCE_HTTP_CONNECT_TIMEOUT_SECONDS=3
BINANCE_RECV_WINDOW_MS=10000
BINANCE_HISTORY_MAX_ATTEMPTS=3
BINANCE_HISTORY_RETRY_DELAY_MS=250
BINANCE_HISTORY_CACHE_SECONDS=20
BINANCE_HISTORY_LOCK_SECONDS=90
BINANCE_HISTORY_MAX_PAGES=8
BINANCE_HISTORY_MAX_WINDOW_SPLITS=8
BINANCE_HISTORY_MAX_DURATION_SECONDS=45
BINANCE_VERIFY_CLOCK_SKEW_SECONDS=0
BINANCE_VERIFY_RATE_LIMIT_ATTEMPTS=5
BINANCE_VERIFY_RATE_LIMIT_DECAY_SECONDS=300
# Leave blank to use APP_URL/admin for the Telegram Mini App dashboard.
TELEGRAM_MINI_APP_URL=
STOREFRONT_TELEGRAM_BOT_URL=https://t.me/lhiestore_bot?start=landing
TELEGRAM_WELCOME_BANNER_URL=
TELEGRAM_PRODUCT_CUSTOM_EMOJI_ENABLED=true
TG_ICON_CHATGPT=
TG_ICON_GEMINI=
TG_ICON_GROK=
TG_ICON_CAPCUT=
TG_ICON_ADOBE=
TG_ICON_CURSOR=
TG_ICON_YOUTUBE=
TG_ICON_KLING=
TG_ICON_LOVABLE=
TG_ICON_NOTION=

# Required only when dashboard payment mode is Pakasir.
PAKASIR_SLUG=
PAKASIR_API_KEY=
PAKASIR_BASE_URL=https://app.pakasir.com
# HTTP timeout applies to every Pakasir API call. Retries apply only to Transaction Detail.
PAKASIR_HTTP_TIMEOUT_SECONDS=10
PAKASIR_HTTP_CONNECT_TIMEOUT_SECONDS=3
PAKASIR_TRANSACTION_DETAIL_MAX_ATTEMPTS=3
PAKASIR_TRANSACTION_DETAIL_RETRY_DELAY_MS=250
PAKASIR_TRANSACTION_DETAIL_RETRY_MAX_DELAY_MS=1000
PAKASIR_RECONCILE_RELEASED_LOOKBACK_HOURS=72
# Optional; leave blank to use Pakasir default hosted-checkout return behavior.
PAKASIR_REDIRECT_URL=
PAKASIR_WEBHOOK_RATE_LIMIT_PER_MINUTE=30
PAKASIR_STATUS_REFRESH_RATE_LIMIT_PER_MINUTE=3
PAKASIR_QRIS_FEE_PAYER=customer
PAKASIR_QRIS_FEE_THRESHOLD=105000
PAKASIR_QRIS_FEE_LOW_BPS=70
PAKASIR_QRIS_FEE_LOW_FIXED=310
PAKASIR_QRIS_FEE_HIGH_BPS=100
PAKASIR_QRIS_FEE_HIGH_FIXED=0
