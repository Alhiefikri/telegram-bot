# Docker deployment identity. Replace the example URL before production.
APP_ENV=production
APP_URL=https://example.com
TRUSTED_PROXIES=
TRUSTED_HOSTS=^example\.com$

# Required secrets.
APP_KEY=
APP_PREVIOUS_KEYS=
POSTGRES_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Optional secret; generated in persistent storage when blank.
CREDENTIAL_IDENTITY_FINGERPRINT_KEY=

# Private admin identifiers and access policy. Dashboard settings take
# precedence for editable destinations.
ADMIN_ALLOWED_LOGINS=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=

# Provider credentials and account identifiers, only when that rail is used.
PAKASIR_SLUG=
PAKASIR_API_KEY=
BINANCE_PAY_ID=
BINANCE_PAY_UID=
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional override for a private or credentialed BSC provider. Public BSC
# endpoints are pinned in src/config/services.php and used as ordered fallbacks
# when this is empty.
BSC_RPC_URL=

# Optional KlikQRIS sandbox/production credentials. Enablement remains a
# reviewed code and Admin Payment Provider Switch decision.
KLIKQRIS_SANDBOX_API_KEY=
KLIKQRIS_SANDBOX_MERCHANT_ID=
KLIKQRIS_PRODUCTION_API_KEY=
KLIKQRIS_PRODUCTION_MERCHANT_ID=

# Optional Sakurupiah merchant credentials. Both production values enable the
# production provider; sandbox values are used only in local/testing.
SAKURUPIAH_SANDBOX_API_ID=
SAKURUPIAH_SANDBOX_API_KEY=
SAKURUPIAH_PRODUCTION_API_ID=
SAKURUPIAH_PRODUCTION_API_KEY=

# Optional transactional email. Leave absent to use Laravel's log mailer.
# MAIL_MAILER=smtp
# MAIL_SCHEME=
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=hello@example.com
# MAIL_FROM_NAME="LHIE STORE"

# Optional encrypted release backup. Configure exactly one on the VPS when
# the destructive contract workflow requires a verified readable backup.
# GPG_RECIPIENT=
# GPG_PASSPHRASE=
