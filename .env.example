APP_NAME="LHIE STORE"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=base64:replace-with-generated-key
# Optional dedicated HMAC key for credential identity no-reuse fingerprints.
# If omitted, the app generates and persists one in storage/app/private.
CREDENTIAL_IDENTITY_FINGERPRINT_KEY=
APP_FORCE_HTTPS=true
APP_TIMEZONE=Asia/Jakarta
TRUSTED_PROXIES=127.0.0.1
TRUSTED_HOSTS=^example\.com$
WEB_PORT=8000

APP_AUTO_MIGRATE=false
APP_OPTIMIZE=true
APP_AUTO_SET_TELEGRAM_WEBHOOK=false

POSTGRES_DB=telegram_bot
POSTGRES_USER=telegram_bot
POSTGRES_PASSWORD=change-me

CACHE_STORE=database
QUEUE_CONNECTION=database
LARAVEL_UPDATE_WORKER_PROCESSES=1
LARAVEL_UPDATE_WORKER_SLEEP=1
LARAVEL_OUTBOUND_WORKER_PROCESSES=1
LARAVEL_OUTBOUND_WORKER_SLEEP=1
LARAVEL_NOTIFICATION_WORKER_PROCESSES=1
LARAVEL_BROADCAST_WORKER_PROCESSES=1
LARAVEL_BROADCAST_WORKER_SLEEP=1
LARAVEL_BINANCE_VERIFICATION_WORKER_PROCESSES=1
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_PARTITIONED_COOKIE=true
FILESYSTEM_DISK=local
BACKUP_DIR=backups
DB_SERVICE=db
# Required for scripts/backup-db.sh; set one encryption mode.
GPG_RECIPIENT=
GPG_PASSPHRASE=
DATA_RETENTION_DAYS=90

MAIL_MAILER=smtp

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
TELEGRAM_API_BASE_URL=https://api.telegram.org
# HTTP timeout applies to every Telegram Bot API call.
TELEGRAM_HTTP_TIMEOUT_SECONDS=10
TELEGRAM_HTTP_CONNECT_TIMEOUT_SECONDS=3
# Let Telegram stop the inline-button spinner from the webhook response itself.
TELEGRAM_WEBHOOK_FAST_CALLBACK_ACK=true
TELEGRAM_WEBHOOK_RATE_LIMIT_PER_MINUTE=120
TELEGRAM_COMMUNITY_GATE_CACHE_SECONDS=15
TELEGRAM_PROCESSING_MAX_ATTEMPTS=3
TELEGRAM_PROCESSING_RETRY_DELAY_SECONDS=60
# Shared Admin Broadcast limiter. Keep this below Telegram's default 30 messages/second.
TELEGRAM_BROADCAST_RATE_LIMIT_PER_SECOND=25
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_ADMIN_USERNAME=alhie02
TELEGRAM_ADMIN_CONTACT_URL=

# Comma-separated admin emails/usernames allowed into the dashboard.
# SECURITY: leave empty and ANY account holding an admin role can sign in
# (User::canAccessAdmin falls open). Set this in production to lock the
# dashboard to named accounts.
ADMIN_ALLOWED_LOGINS=
WHATSAPP_SUPPORT_URL=
WHATSAPP_SUPPORT_NUMBER=
# Required only when Binance Pay is enabled in the admin dashboard.
BINANCE_PAY_ID=
BINANCE_PAY_UID=
# Optional read-only Binance API credentials enable automatic payment verification.
# Restrict this key by IP and grant read permission only.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_VERIFICATION_QUEUE=binance-verification
DB_QUEUE_RETRY_AFTER=180
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_HTTP_TIMEOUT_SECONDS=10
BINANCE_HTTP_CONNECT_TIMEOUT_SECONDS=3
BINANCE_RECV_WINDOW_MS=10000
BINANCE_HISTORY_MAX_ATTEMPTS=3
BINANCE_HISTORY_RETRY_DELAY_MS=250
BINANCE_HISTORY_CACHE_SECONDS=20
BINANCE_HISTORY_LOCK_SECONDS=90
BINANCE_HISTORY_MAX_PAGES=8
BINANCE_HISTORY_MAX_WINDOW_SPLITS=8
BINANCE_HISTORY_MAX_DURATION_SECONDS=45
BINANCE_VERIFY_CLOCK_SKEW_SECONDS=0
BINANCE_VERIFY_RATE_LIMIT_ATTEMPTS=5
BINANCE_VERIFY_RATE_LIMIT_DECAY_SECONDS=300

# BNB Smart Chain authority. This is the only BSC value in ENV because the
# provider RPC URL may contain credentials. Receiver addresses and network
# identity are managed/pinned outside environment configuration.
BSC_RPC_URL=
# Leave blank to use APP_URL/admin for the Telegram Mini App dashboard.
TELEGRAM_MINI_APP_URL=
STOREFRONT_TELEGRAM_BOT_URL=https://t.me/lhiestore_bot?start=landing
TELEGRAM_WELCOME_BANNER_URL=

# Required only when dashboard payment mode is Pakasir.
PAKASIR_SLUG=
PAKASIR_API_KEY=
PAKASIR_BASE_URL=https://app.pakasir.com
# HTTP timeout applies to every Pakasir API call. Retries apply only to Transaction Detail.
PAKASIR_HTTP_TIMEOUT_SECONDS=10
PAKASIR_HTTP_CONNECT_TIMEOUT_SECONDS=3
PAKASIR_TRANSACTION_DETAIL_MAX_ATTEMPTS=3
PAKASIR_TRANSACTION_DETAIL_RETRY_DELAY_MS=250
PAKASIR_TRANSACTION_DETAIL_RETRY_MAX_DELAY_MS=1000
PAKASIR_RECONCILE_RELEASED_LOOKBACK_HOURS=72
# Optional; leave blank to use Pakasir default hosted-checkout return behavior.
PAKASIR_REDIRECT_URL=
PAKASIR_WEBHOOK_RATE_LIMIT_PER_MINUTE=30
PAKASIR_STATUS_REFRESH_RATE_LIMIT_PER_MINUTE=3
PAKASIR_QRIS_FEE_PAYER=customer
PAKASIR_QRIS_FEE_THRESHOLD=105000
PAKASIR_QRIS_FEE_LOW_BPS=70
PAKASIR_QRIS_FEE_LOW_FIXED=310
PAKASIR_QRIS_FEE_HIGH_BPS=100
PAKASIR_QRIS_FEE_HIGH_FIXED=0
# Only recently released KlikQRIS payments are reconciled; outcome-unknown payments remain eligible.
KLIKQRIS_RECONCILE_TERMINAL_LOOKBACK_HOURS=72
# Bounded execution for the per-minute reconciliation sweep. The scheduler
# mutex expiry must stay above this so a slow provider cannot make sweeps overlap.
KLIKQRIS_RECONCILE_MAX_EXECUTION_SECONDS=45
# How many eligible rows the fair cursor may scan forward in one sweep before
# treating the sweep as caught up.
KLIKQRIS_RECONCILE_CURSOR_SCAN_CAP=500
# Sakurupiah is disabled until sandbox contract qualification and owner approval.
# API IDs/keys are credentials: keep them blank here and inject them as secrets.
SAKURUPIAH_SANDBOX_ENABLED=false
SAKURUPIAH_SANDBOX_BASE_URL=https://sakurupiah.id/api-sanbox/
SAKURUPIAH_SANDBOX_API_ID=
SAKURUPIAH_SANDBOX_API_KEY=
SAKURUPIAH_SANDBOX_CALLBACK_URL=
SAKURUPIAH_SANDBOX_RETURN_URL=
# Comma-separated host/IP policy placeholders; never put catalog or display
# settings in ENV.
SAKURUPIAH_SANDBOX_ALLOWED_HOSTS=
SAKURUPIAH_SANDBOX_CALLBACK_ALLOWED_HOSTS=
SAKURUPIAH_SANDBOX_RETURN_ALLOWED_HOSTS=
SAKURUPIAH_SANDBOX_ALLOWED_IPS=
SAKURUPIAH_PRODUCTION_ENABLED=false
SAKURUPIAH_PRODUCTION_BASE_URL=https://sakurupiah.id/api/
SAKURUPIAH_PRODUCTION_API_ID=
SAKURUPIAH_PRODUCTION_API_KEY=
SAKURUPIAH_PRODUCTION_CALLBACK_URL=
SAKURUPIAH_PRODUCTION_RETURN_URL=
SAKURUPIAH_PRODUCTION_ALLOWED_HOSTS=
SAKURUPIAH_PRODUCTION_CALLBACK_ALLOWED_HOSTS=
SAKURUPIAH_PRODUCTION_RETURN_ALLOWED_HOSTS=
SAKURUPIAH_PRODUCTION_ALLOWED_IPS=
SAKURUPIAH_TIMEZONE=Asia/Jakarta
SAKURUPIAH_HTTP_TIMEOUT_SECONDS=10
SAKURUPIAH_HTTP_CONNECT_TIMEOUT_SECONDS=3
SAKURUPIAH_LOOKUP_MAX_ATTEMPTS=3
SAKURUPIAH_LOOKUP_RETRY_DELAY_MS=250
SAKURUPIAH_LOOKUP_RETRY_MAX_DELAY_MS=1000
SAKURUPIAH_LOCK_LEASE_SECONDS=90
SAKURUPIAH_WEBHOOK_RATE_LIMIT_PER_MINUTE=30
SAKURUPIAH_STATUS_REFRESH_RATE_LIMIT_PER_MINUTE=3
SAKURUPIAH_READINESS_CACHE_SECONDS=60
