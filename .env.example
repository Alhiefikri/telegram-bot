APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=base64:replace-with-generated-key
FORCE_HTTPS=true
TRUSTED_PROXIES=127.0.0.1
TRUSTED_HOSTS=^example\.com$
WEB_PORT=8000

POSTGRES_DB=telegram_bot
POSTGRES_USER=telegram_bot
POSTGRES_PASSWORD=change-me

QUEUE_CONNECTION=database
BACKUP_DIR=backups
DB_SERVICE=db

TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_DEFAULT_PAYMENT_METHOD=BRIVA
TELEGRAM_WEBHOOK_RATE_LIMIT_PER_MINUTE=120

TRIPAY_API_KEY=replace-me
TRIPAY_PRIVATE_KEY=replace-me
TRIPAY_MERCHANT_CODE=replace-me
TRIPAY_BASE_URL=https://tripay.co.id/api
TRIPAY_CALLBACK_URL=https://example.com/api/webhook/tripay
TRIPAY_RETURN_URL=https://example.com/thanks
TRIPAY_WEBHOOK_RATE_LIMIT_PER_MINUTE=30
TRIPAY_WEBHOOK_MAX_BODY_BYTES=65536
