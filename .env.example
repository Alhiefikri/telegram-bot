APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=base64:replace-with-generated-key
FORCE_HTTPS=true
TRUSTED_PROXIES=127.0.0.1
TRUSTED_HOSTS=^example\.com$
WEB_PORT=8000
APP_AUTO_MIGRATE=true
APP_AUTO_SET_TELEGRAM_WEBHOOK=false
DOGFOOD_TIMING_LOG_CHANNEL=

POSTGRES_DB=telegram_bot
POSTGRES_USER=telegram_bot
POSTGRES_PASSWORD=change-me

QUEUE_CONNECTION=database
BACKUP_DIR=backups
DB_SERVICE=db

TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_PAYMENT_MODE=manual
TELEGRAM_DEFAULT_PAYMENT_METHOD=BRIVA
TELEGRAM_WEBHOOK_RATE_LIMIT_PER_MINUTE=120

DOGFOOD_TELEGRAM_PHOTO_FILE_ID=
DOGFOOD_STORE_CHANNEL_CHAT_ID=
DOGFOOD_STORE_CHANNEL_USERNAME=
DOGFOOD_STORE_CHANNEL_LINK=
DOGFOOD_STORE_CHANNEL_MEMBER_USER_ID=
DOGFOOD_STORE_CHANNEL_NON_MEMBER_USER_ID=
DOGFOOD_TELEGRAM_CALLBACK_QUERY_ID=
DOGFOOD_PAKASIR_PENDING_ORDER_ID=
DOGFOOD_PAKASIR_PENDING_AMOUNT=

PAKASIR_SLUG=replace-me
PAKASIR_API_KEY=replace-me
PAKASIR_BASE_URL=https://app.pakasir.com
PAKASIR_REDIRECT_URL=https://example.com/thanks
PAKASIR_QRIS_ONLY=false

# TRIPAY_LEGACY_OPTIONAL: compatibility only for old records/tests.
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_BASE_URL=https://tripay.co.id/api
TRIPAY_CALLBACK_URL=https://example.com/api/webhook/tripay
TRIPAY_RETURN_URL=https://example.com/thanks
TRIPAY_WEBHOOK_RATE_LIMIT_PER_MINUTE=30
TRIPAY_WEBHOOK_MAX_BODY_BYTES=65536
